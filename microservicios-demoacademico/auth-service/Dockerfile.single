# Actividad 3: compilar y ejecutar en una sola etapa.
# La imagen final conserva Maven, el JDK completo, el codigo fuente y la cache ~/.m2.
FROM maven:3.9.9-eclipse-temurin-21
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn -B clean package -DskipTests
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "target/auth-service-0.0.1-SNAPSHOT.jar"]
